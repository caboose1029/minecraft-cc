{
  "crushing": {
    "produces": [
      "create:crushed_raw_iron",
      "create:crushed_raw_gold",
      "create:crushed_raw_copper",
      "create:crushed_raw_zinc"
    ],
    "kind": "machine"
  },
  "milling": {
    "produces": ["create:wheat_flour"],
    "kind": "machine"
  },
  "smelter": {
    "produces": [
      "minecraft:iron_ingot",
      "minecraft:gold_ingot",
      "minecraft:copper_ingot",
      "create:zinc_ingot",
      "minecraft:charcoal",
      "minecraft:stone",
      "minecraft:glass",
      "minecraft:brick",
      "minecraft:bread"
    ],
    "kind": "machine"
  },
  "smoker": {
    "produces": [
      "minecraft:dried_kelp",
      "minecraft:cooked_beef",
      "minecraft:cooked_chicken",
      "minecraft:cooked_porkchop",
      "minecraft:baked_potato"
    ],
    "kind": "machine"
  },
  "pressing": {
    "produces": ["create:iron_sheet", "create:copper_sheet", "create:golden_sheet", "create:brass_sheet"],
    "kind": "machine"
  },
  "mixing_unheated": {
    "produces": ["create:andesite_alloy"],
    "kind": "machine"
  },
  "mixing_heated": {
    "produces": ["create:brass_ingot"],
    "kind": "machine",
    "timeoutSeconds": 45
  },
  "compacting": {
    "produces": ["minecraft:ice"],
    "kind": "machine"
  },
  "deploying": {
    "produces": ["create:andesite_casing", "create:brass_casing", "create:copper_casing"],
    "kind": "machine"
  },
  "splashing": {
    "produces": ["minecraft:packed_ice", "minecraft:obsidian"],
    "kind": "machine"
  },
  "filling": {
    "produces": ["minecraft:lava_bucket"],
    "kind": "machine"
  },
  "slicer": {
    "produces": ["minecraft:stripped_oak_log", "farmersdelight:chicken_cuts", "farmersdelight:pumpkin_slice"],
    "kind": "machine"
  },
  "cooking_pot": {
    "produces": ["farmersdelight:beef_stew"],
    "kind": "machine"
  },
  "crafter": {
    "produces": ["minecraft:chest", "minecraft:dried_kelp_block"],
    "kind": "crafter"
  },
  "wood_farm": {
    "kind": "farm",
    "watermarks": [
      { "item": "minecraft:oak_log", "lowWatermark": 64, "highWatermark": 256 }
    ]
  },
  "kelp_farm": {
    "kind": "farm",
    "watermarks": [
      { "item": "minecraft:kelp", "lowWatermark": 128, "highWatermark": 512 }
    ]
  },
  "iron_andesite_farm": {
    "kind": "farm",
    "watermarks": [
      { "item": "minecraft:iron_ingot", "lowWatermark": 64, "highWatermark": 256 },
      { "item": "minecraft:andesite", "lowWatermark": 64, "highWatermark": 256 }
    ]
  },
  "copper_farm": {
    "kind": "farm",
    "watermarks": [
      { "item": "minecraft:copper_ingot", "lowWatermark": 64, "highWatermark": 256 }
    ]
  }
}
